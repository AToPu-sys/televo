{
  "expo": {
    "name": "Televo",
    "slug": "televo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "televo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.televo.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Televo uses your microphone for voice and video calls.",
        "NSCameraUsageDescription": "Televo uses your camera for video calls.",
        "NSPhotoLibraryUsageDescription": "Televo needs access to your photos so you can send them in chats.",
        "NSPhotoLibraryAddUsageDescription": "Televo saves photos and videos you download from chats to your library.",
        "NSContactsUsageDescription": "Televo uses your contacts to find friends who already use Televo. Contacts are hashed before they are sent and are never stored in the clear.",
        "NSFaceIDUsageDescription": "Televo uses Face ID to unlock the app.",
        "UIBackgroundModes": [
          "audio",
          "voip",
          "remote-notification"
        ]
      },
      "buildNumber": "96",
      "associatedDomains": [
        "applinks:gettelevo.space"
      ]
    },
    "android": {
      "package": "com.televo.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.USE_FULL_SCREEN_INTENT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 87
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "./plugins/ios-scene-delegate/withIosSceneLifecycle.js",
      "./plugins/ios-pods-deployment-target/withPodsDeploymentTarget.js",
      "./plugins/notification-service/withNotificationService.js",
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos so you can send them in chats."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow $(PRODUCT_NAME) to access your contacts to find friends who are already here."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#3390EC",
          "sounds": ["./assets/ringtone.wav"]
        }
      ],
      "expo-audio",
      "expo-video",
      "@config-plugins/react-native-webrtc",
      [
        "expo-camera",
        {
          "cameraPermission": "Televo uses your camera to scan QR codes for signing in on a new device."
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dbc1a325-ce23-4fe9-93df-f1786be38aa0"
      }
    },
    "owner": "bek523627273727"
  }
}
