# Copy to .env and fill in your Supabase project values.
# Both are safe to expose in a client app: the publishable key is designed for
# public use and access is enforced by Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# TURN relay for calls (e.g. https://www.expressturn.com, free with an email).
# Without it, calls between two phones on mobile data often fail to connect.
EXPO_PUBLIC_TURN_USERNAME=your_turn_username
EXPO_PUBLIC_TURN_CREDENTIAL=your_turn_credential
